# Avtokraski_Pro
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Старые адреса товаров после переименования -> новые (сохраняем позиции в поиске)
Redirect 301 /raspyliteli/usi/ https://avtokraskipro.kz/raspyliteli/walcom/
Redirect 301 /brand/usi/ https://avtokraskipro.kz/brand/walcom/
Redirect 301 /brand/nar-ppm-hpx/ https://avtokraskipro.kz/brand/hpx/
Redirect 301 /tovar/055353-spotter-2700-moschnost-2600a-230v/ https://avtokraskipro.kz/tovar/055353-spotter-gys-gyspot-2700-2600-a-230-v/
Redirect 301 /tovar/8230-kraskopult-walcom-aer-slim-xlight-hte-1-3mm-1-4mm-1-7mm-1-9mm-2/ https://avtokraskipro.kz/tovar/8230-kraskopult-walcom-aer-slim-xlight-halo-hte-1-3mm-1-4mm-1-5mm-1/
Redirect 301 /tovar/10083-kraskopult-walcom-slim-s-halo-sr-10083-soplo-1-3-1-5-1-7/ https://avtokraskipro.kz/tovar/10083-kraskopult-walcom-slim-s-halo-sr-10083-soplo-1-3-1-5-1-7-2-5/
Redirect 301 /tovar/w093013-kraskopult-slim-kombat-pro-halo-1-3/ https://avtokraskipro.kz/tovar/w093013-kraskopult-slim-kombat-pro-halo-1-3-1-4-1-7-1-9-2-2-2-5/
Redirect 301 /tovar/w093014-kraskopult-slim-kombat-pro-halo-1-4/ https://avtokraskipro.kz/tovar/w093014-kraskopult-slim-kombat-pro-halo-1-3-1-4-1-7-1-9-2-2-2-5/
Redirect 301 /tovar/w093013-gang-kraskopult-slim-kombat-pro-gang-hte-halo-1-3/ https://avtokraskipro.kz/tovar/w093013-gang-kraskopult-slim-kombat-pro-gang-hte-halo-1-3-1-4-1-7-1-9/
Redirect 301 /tovar/w013013-kraskopult-genesi-carbonio-360-evo-clear-hte-1-3/ https://avtokraskipro.kz/tovar/w013013-kraskopult-genesi-carbonio-360-evo-clear-halo-hte-1-2-1-3-1-4/
Redirect 301 /tovar/w010013-rem-komplekt-genesi-carbonio-360-evo-clear-hte-1-3/ https://avtokraskipro.kz/tovar/w010013-rem-komplekt-genesi-carbonio-360-evo-clear-halo-hte-1-2-1-3-1/
Redirect 301 /tovar/w020013-rem-komplekt-genesi-carbonio-360-evo-base-hte-1-3/ https://avtokraskipro.kz/tovar/w020013-rem-komplekt-genesi-carbonio-360-evo-base-halo-hte-1-2-1-3-1-4/
Redirect 301 /tovar/50160-b-moechnyj-pistolet-austromec-hydrojet/ https://avtokraskipro.kz/tovar/50160-b-moechnyj-pistolet-asturomec-hydrojet/

# Перенаправление на https: включить (убрать # в 4 строках ниже) после установки SSL-сертификата
#RewriteEngine On
#RewriteCond %{HTTPS} off [OR]
#RewriteCond %{HTTP_HOST} ^www\. [NC]
#RewriteRule ^ https://avtokraskipro.kz%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
